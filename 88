def sauvegarder_resultats(df_fenetres, df_points, stats_ref):
    """
    Sauvegarde les résultats dans un fichier Excel multi-feuilles.
    """
    nom_fichier_sortie = "resultats_capteur_temperature_corriges.xlsx"

    with pd.ExcelWriter(nom_fichier_sortie, engine="openpyxl") as writer:
        df_fenetres.to_excel(writer, sheet_name="Fenetres", index=False)
        df_points.to_excel(writer, sheet_name="Points_residus", index=False)
        stats_table = pd.DataFrame([{
            "mu_res_ref": stats_ref["mu_res_ref"],
            "sigma_res_ref": stats_ref["sigma_res_ref"],
            "mu_pente_ref": stats_ref["mu_pente_ref"],
            "sigma_pente_ref": stats_ref["sigma_pente_ref"],
            "mu_std_res_ref": stats_ref["mu_std_res_ref"],
            "mu_rmse_res_ref": stats_ref["mu_rmse_res_ref"],
            "mu_brut_ref": stats_ref["mu_brut_ref"],
            "sigma_brut_ref": stats_ref["sigma_brut_ref"],
            "T_ab_ref": stats_ref["T_ab_ref"]
        }])
        stats_table.to_excel(writer, sheet_name="Stats_reference", index=False)

    print(f"Résultats sauvegardés dans : {nom_fichier_sortie}")


