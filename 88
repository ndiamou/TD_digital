def tracer_boxplots_reference_vs_courant(df_fenetres):
    """
    Boxplots :
    - pentes référence vs courant
    - std(res) référence vs courant
    - ratio d'aberrants référence vs courant (ou plutôt T_ab)
    """
    df_ref = df_fenetres[df_fenetres["annee"].isin(annee_ref)].copy()
    df_courant = df_fenetres[~df_fenetres["annee"].isin(annee_ref)].copy()

    fig = make_subplots(
        rows=1, cols=3,
        subplot_titles=[
            "Pentes : référence vs courant",
            "Dispersion des résidus : référence vs courant",
            "Taux d'aberrants : référence vs courant"
        ]
    )

    # 1) Pentes
    fig.add_trace(go.Box(y=df_ref["pente"], name="Référence"), row=1, col=1)
    fig.add_trace(go.Box(y=df_courant["pente"], name="Courant"), row=1, col=1)

    # 2) std_res
    fig.add_trace(go.Box(y=df_ref["std_res"], name="Référence"), row=1, col=2)
    fig.add_trace(go.Box(y=df_courant["std_res"], name="Courant"), row=1, col=2)

