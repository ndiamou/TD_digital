    fig.add_trace(go.Box(y=df_ref["T_ab_courant"], name="Référence"), row=1, col=3)
    fig.add_trace(go.Box(y=df_courant["T_ab_courant"], name="Courant"), row=1, col=3)

    fig.update_layout(
        title="Graphe 2 - Référence vs courant",
        template="plotly_white",
        showlegend=False
    )

    fig.show()


def tracer_signature_residu_vs_pente(df_points, stats_ref):
    """
    Diagramme signature :
    X = résidu
    Y = pente

    On ajoute une zone de référence visuelle :
    - en X : mu_res_ref ± 3*sigma_res_ref
    - en Y : mu_pente_ref ± 3*sigma_pente_ref
    """
    couleurs = {
        "normal": "black",
        "degradation": "orange",
        "grossier": "red"
    }

    mu_res_ref = stats_ref["mu_res_ref"]
    sigma_res_ref = stats_ref["sigma_res_ref"]
    mu_pente_ref = stats_ref["mu_pente_ref"]
    sigma_pente_ref = stats_ref["sigma_pente_ref"]

    x0 = mu_res_ref - 3 * sigma_res_ref
    x1 = mu_res_ref + 3 * sigma_res_ref
    y0 = mu_pente_ref - 3 * sigma_pente_ref
    y1 = mu_pente_ref + 3 * sigma_pente_ref

    fig = go.Figure()

    # Rectangle de référence
    fig.add_shape(
        type="rect",
        x0=x0, x1=x1,
        y0=y0, y1=y1,
        line=dict(color="green", width=2),
        fillcolor="rgba(0,255,0,0.10)"
    )

    # Points par classe
    for classe in ["normal", "degradation", "grossier"]:
        sous_df = df_points[df_points["classe_finale"] == classe].copy()

        if not sous_df.empty:
            fig.add_trace(go.Scatter(
                x=sous_df["residu"],
                y=sous_df["pente_fenetre"],
                mode="markers",
                name=classe,
                marker=dict(color=couleurs[classe], size=5, opacity=0.75)
            ))

    fig.update_layout(
        title="Graphe 3 - Signature capteur : résidu en fonction de la pente",
        xaxis_title="Résidu",
        yaxis_title="Pente locale",
        template="plotly_white"
    )

    fig.show()


def tracer_evolution_scores(df_fenetres):
    """
    Graphe des indicateurs quantitatifs dans le temps :
    - Z_mu_res
    - Z_sigma_res
    - Ratio_ab
    """
    fig = make_subplots(
        rows=3, cols=1,
        shared_xaxes=True,
        subplot_titles=[
            "Evolution de Z_mu_res",
            "Evolution de Z_sigma_res",
            "Evolution de Ratio_ab"
        ]
    )

    # Z_mu_res
    fig.add_trace(go.Scatter(
        x=df_fenetres["date_centre"],
        y=df_fenetres["Z_mu_res"],
        mode="lines+markers",
        name="Z_mu_res"
    ), row=1, col=1)

    fig.add_hline(y=1, line_dash="dash", line_color="orange", row=1, col=1)
    fig.add_hline(y=2, line_dash="dash", line_color="red", row=1, col=1)
    fig.add_hline(y=3, line_dash="dash", line_color="darkred", row=1, col=1)

    # Z_sigma_res
    fig.add_trace(go.Scatter(
        x=df_fenetres["date_centre"],
        y=df_fenetres["Z_sigma_res"],
        mode="lines+markers",
        name="Z_sigma_res"
    ), row=2, col=1)

    fig.add_hline(y=1, line_dash="dash", line_color="orange", row=2, col=1)
    fig.add_hline(y=1.5, line_dash="dash", line_color="red", row=2, col=1)
    fig.add_hline(y=2, line_dash="dash", line_color="darkred", row=2, col=1)

    # Ratio_ab
    fig.add_trace(go.Scatter(
        x=df_fenetres["date_centre"],
        y=df_fenetres["Ratio_ab"],
        mode="lines+markers",
        name="Ratio_ab"
    ), row=3, col=1)

    fig.add_hline(y=1, line_dash="dash", line_color="orange", row=3, col=1)
    fig.add_hline(y=2, line_dash="dash", line_color="red", row=3, col=1)
    fig.add_hline(y=3, line_dash="dash", line_color="darkred", row=3, col=1)

    fig.update_layout(
        title="Graphe 4 - Evolution temporelle des scores",
        xaxis_title="Temps",
        template="plotly_white",
        height=900
    )

    fig.show()


