    df = construire_colonnes_temps(df, COL_DATE)

    print("Construction de la zone de référence solide 2018-2019...")

    mask_ref_points = calcul_stabilite_ref(df, COL_VAR, annees=annee_ref)

    nb_ref = np.sum(mask_ref_points)
    print(f"Nombre de points appartenant à la référence stable : {nb_ref}")

    if nb_ref == 0:
        raise ValueError(
            "Aucun point de référence stable n'a été trouvé. "
            "Il faut revoir les seuils pmin, pmax, r2max."
        )

    print("Calcul de toutes les fenêtres glissantes...")
    df_fenetres, df_points = calcul_fenetres_glissantes(df, COL_VAR)

    if df_fenetres.empty or df_points.empty:
        raise ValueError(
            "Aucune fenêtre exploitable n'a été calculée. "
            "Vérifie T_segment, pas_glissement et la densité des données."
        )

    print("Calcul des statistiques de référence...")
    stats_ref = calcul_stats_reference(df, df_fenetres, df_points, mask_ref_points)

    print("Calcul des scores et classification...")
    df_fenetres = classer_fenetres(df_fenetres, df_points, stats_ref)

    print("Attribution des classes aux points...")
    df_points = attribuer_classes_aux_points(df_points, df_fenetres)

    print("Sauvegarde des résultats...")
    sauvegarder_resultats(df_fenetres, df_points, stats_ref)

    print("Affichage des graphiques...")
    tracer_residus_vs_temps(df_points, df, mask_ref_points)
    tracer_boxplots_reference_vs_courant(df_fenetres)
    tracer_signature_residu_vs_pente(df_points, stats_ref)
    tracer_evolution_scores(df_fenetres)

    print("Analyse terminée avec succès.")


